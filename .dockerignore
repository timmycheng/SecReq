# 版本控制与本地环境
.git
.gitignore
.venv
.pytest_cache
__pycache__
**/__pycache__
.zcode
.workbuddy

# 前端依赖与本地构建产物(镜像内重新构建)
node_modules
**/node_modules
frontend/dist

# 本地数据与产物(容器内挂载卷, 不打入镜像)
secreq.db
output
data

# 不参与运行的内容
tests
.github
*.md
# 例外: 更新日志页(#55)在运行时读取 CHANGELOG.md, 必须进镜像
!CHANGELOG.md

# 例外: CI 用 oras 拉取的漏洞库基线必须进入构建上下文
!vulndb.sqlite
!vulndb.sqlite.sha256
