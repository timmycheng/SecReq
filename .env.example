# SecReq 环境变量样例(复制为 .env 后按实际环境填写)
#
# 内网部署请配合 docker-compose.intranet.yml 使用。
# 注意: .env 含初始口令, 不要提交到版本库(已在 .gitignore 中排除)。

# ── 必填(内网部署) ────────────────────────────────────
# 种子账号(dev_li / dev_zhang / sec_chen / sec_zhao)的初始密码。
# 未设置时后端会随机生成并打印到启动日志 —— 仅适合本地演示, 不适合内网交付。
SECREQ_SEED_PASSWORD=change-me-please

# ── 可选 ──────────────────────────────────────────────
# 数据库连接串; 默认 sqlite:////app/data/secreq.db
# SECREQ_DATABASE_URL=sqlite:////app/data/secreq.db

# 日志级别; 默认 INFO
# SECREQ_LOG_LEVEL=INFO

# ── 离线漏洞库(v2.2.0) ────────────────────────────────
# 漏洞数据源链(逗号分隔, 前一个不可用时自动降级到后一个并记日志, 不静默失败):
#   local   本地离线漏洞库(内网默认, 不访问任何外部服务)
#   online  OSV.dev 在线库(需互联网, 仅开发/演示环境)
#   sca     行内 SCA 平台(尚未接入; 选中会明确报"未启用", 不会静默放过)
# SECREQ_VULN_SOURCE=local

# 漏洞库文件路径; 默认 <SECREQ_DATA_DIR>/vulndb.sqlite。
# 镜像内置基线库; 挂载外部库可覆盖, 更新漏洞数据不必重建镜像。
# SECREQ_VULNDB_PATH=/app/data/vulndb.sqlite

# 数据目录(主库 / 漏洞库 / CNNVD 映射库); 默认 ./data, 容器内为 /app/data
# SECREQ_DATA_DIR=/app/data
